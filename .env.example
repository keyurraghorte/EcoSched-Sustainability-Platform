# Supabase Dashboard > Project Settings > Database > Connection string > URI
# Use the Session pooler URI for local development if direct connections are unavailable.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require

# Supabase browser/API access. Add these same variables in Vercel Project Settings.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[SUPABASE-PUBLISHABLE-KEY]
